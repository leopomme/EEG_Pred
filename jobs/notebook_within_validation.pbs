set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/notebook_within_validation_01.log 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python
"$PY" -u scripts/run_classical.py --competition within_subject --recipes csp_full --fit-final --output results/within_subject/notebook_reference_01
