#!/bin/bash
#PBS -N eeg_dl_cross_dev
#PBS -l select=1:ncpus=4:mem=12gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -o /rds/general/user/lh5218/home/EEG_pred/logs/
#PBS -e /rds/general/user/lh5218/home/EEG_pred/logs/
set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/neural_cross_development.log 2>&1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python -u scripts/run_neural.py --competition cross_subject --window task0_48 --folds 2,3,4 --output results/cross_subject/dl_development_full
