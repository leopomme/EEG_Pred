#!/bin/bash
#PBS -N eeg_ml_stress
#PBS -l select=1:ncpus=2:mem=10gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /rds/general/user/lh5218/home/EEG_pred/logs/
#PBS -e /rds/general/user/lh5218/home/EEG_pred/logs/
set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/ml_within_stress.log 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python
"$PY" -u scripts/run_classical.py --competition within_subject --recipes erp_pre,power_full,tangent_full,csp_full --validation forward --output results/within_subject/ml_forward
"$PY" -u scripts/run_classical.py --competition within_subject --recipes erp_pre,power_full,tangent_full,csp_full --validation calibration --output results/within_subject/ml_calibration
