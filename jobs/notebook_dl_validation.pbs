#!/bin/bash
#PBS -N eeg_dl_notebooks
#PBS -l select=1:ncpus=4:mem=12gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o /rds/general/user/lh5218/home/EEG_pred/logs/
#PBS -e /rds/general/user/lh5218/home/EEG_pred/logs/
set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/notebook_dl_validation.log 2>&1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8
PY=/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
"$PY" -u scripts/run_notebook_local.py notebooks/within_subject_dl.ipynb --threads 4 --data-root data/within_subject --output results/within_subject/dl_notebook_validation_01 --compare-predictions results/within_subject/dl_pilot_full/test_predictions.csv --atol 0.000001
"$PY" -u scripts/run_notebook_local.py notebooks/cross_subject_dl.ipynb --threads 4 --data-root data/cross_subject --output results/cross_subject/dl_notebook_validation_01
"$PY" -u scripts/run_neural.py --competition cross_subject --window task0_48 --folds 5 --output results/cross_subject/dl_confirmation
