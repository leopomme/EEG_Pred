set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/neural_cpu_benchmark.log 2>&1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python -u scripts/run_neural.py --competition cross_subject --window task0_2 --folds 0 --max-epochs 2 --patience 2 --device cpu --threads 4 --output results/cross_subject/dl_cpu_benchmark
