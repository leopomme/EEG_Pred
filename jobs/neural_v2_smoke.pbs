#!/bin/bash
#PBS -N eeg_v2_smoke
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o /rds/general/user/lh5218/home/EEG_pred/logs/
#PBS -e /rds/general/user/lh5218/home/EEG_pred/logs/
set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/neural_v2_smoke.log 2>&1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python
for mode in phase_stable phase_baseline cue_baseline; do
    "$PY" -u scripts/run_neural_v2.py --competition cross_subject --mode "$mode" --device cpu --folds 0 --max-epochs 2 --output "results/cross_subject/v2_smoke_$mode"
    "$PY" -u scripts/run_neural_v2.py --competition within_subject --mode "$mode" --device cpu --subjects S001 --folds 0 --max-epochs 2 --output "results/within_subject/v2_smoke_$mode"
done
