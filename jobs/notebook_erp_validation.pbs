set -euo pipefail
cd /rds/general/user/lh5218/home/EEG_pred
mkdir -p logs
exec > logs/notebook_erp_validation.log 2>&1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
PY=/rds/general/user/lh5218/home/anaconda3/envs/myenv/bin/python
"$PY" -u scripts/fit_erp_final.py --output results/cross_subject/erp_notebook_reference_01
"$PY" -u scripts/run_notebook_local.py notebooks/cross_subject_erp_template_ml.ipynb --data-root data/cross_subject --output results/cross_subject/erp_notebook_validation_01 --compare-predictions results/cross_subject/erp_notebook_reference_01/test_predictions.csv
